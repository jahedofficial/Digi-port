// Prisma schema for Ads Command Center
// Platforms: Google Ads, Meta Ads, TikTok Ads

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformType {
  GOOGLE_ADS
  META_ADS
  TIKTOK_ADS
}

enum ConnectionStatus {
  CONNECTED
  EXPIRED
  ERROR
}

enum EntityStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CreativeFormat {
  IMAGE
  VIDEO
  CAROUSEL
  COLLECTION
  UGC
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  UNDONE
}

enum ActionType {
  PAUSE_AD
  ENABLE_AD
  CHANGE_BUDGET
  CHANGE_BID_TARGET
  ADD_NEGATIVE_KEYWORD
}

enum HealthStatus {
  GREEN
  YELLOW
  RED
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connections PlatformConnection[]
  rules       OptimizationRule[]
  actions     ActionItem[]
  auditLogs   AuditLog[]
  reports     Report[]
  tracking    TrackingHealthCheck[]
  conversations AgentConversation[]
}

model PlatformConnection {
  id                  String           @id @default(uuid())
  workspaceId         String
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform            PlatformType
  accountId           String           // External account ID e.g. act_123 or 987-654-3210
  accountName         String
  status              ConnectionStatus @default(CONNECTED)
  encryptedAccessToken String
  encryptedRefreshToken String?
  tokenExpiresAt      DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  campaigns           Campaign[]
  trackingChecks      TrackingHealthCheck[]

  @@unique([platform, accountId])
}

model Campaign {
  id            String             @id @default(uuid())
  connectionId  String
  connection    PlatformConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId    String             @unique
  name          String
  status        EntityStatus       @default(ACTIVE)
  objective     String?
  budgetType    String?            // CBO / Daily / Lifetime
  dailyBudget   Decimal?           @db.Decimal(12, 2)
  lifetimeBudget Decimal?          @db.Decimal(12, 2)
  currency      String             @default("USD")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  adSets        AdSet[]
  dailyMetrics  DailyMetrics[]
}

model AdSet {
  id            String             @id @default(uuid())
  campaignId    String
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId    String             @unique
  name          String
  status        EntityStatus       @default(ACTIVE)
  dailyBudget   Decimal?           @db.Decimal(12, 2)
  bidStrategy   String?
  bidTarget     Decimal?           @db.Decimal(12, 2)
  targetingJson Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  ads           Ad[]
  dailyMetrics  DailyMetrics[]
}

model Creative {
  id            String          @id @default(uuid())
  externalId    String?         @unique
  name          String
  format        CreativeFormat  @default(IMAGE)
  mediaUrl      String?
  thumbnailUrl  String?
  headline      String?
  bodyCopy      String?
  callToAction  String?
  aiTagsJson    Json?           // Hook type, offer, visual description, transcription
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ads           Ad[]
  tags          CreativeTag[]
}

model Ad {
  id            String         @id @default(uuid())
  adSetId       String
  adSet         AdSet          @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creativeId    String?
  creative      Creative?      @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  externalId    String         @unique
  name          String
  status        EntityStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  dailyMetrics  DailyMetrics[]
}

model DailyMetrics {
  id                String       @id @default(uuid())
  date              DateTime     @db.Date
  platform          PlatformType
  campaignId        String?
  campaign          Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId           String?
  adSet             AdSet?       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  adId              String?
  ad                Ad?          @relation(fields: [adId], references: [id], onDelete: Cascade)

  // Core metrics
  impressions       Int          @default(0)
  clicks            Int          @default(0)
  spend             Decimal      @default(0.0) @db.Decimal(12, 2)
  conversions       Int          @default(0)
  conversionValue   Decimal      @default(0.0) @db.Decimal(12, 2)

  // Video & creative metrics (Hook & Hold rate calculation)
  videoViews3s      Int          @default(0)
  videoViews15s     Int          @default(0)
  videoThruPlays    Int          @default(0)
  reach             Int          @default(0)
  frequency         Decimal      @default(1.0) @db.Decimal(6, 2)

  // Calculated performance metrics
  ctr               Decimal      @default(0.0) @db.Decimal(6, 3)
  cpc               Decimal      @default(0.0) @db.Decimal(8, 2)
  cpa               Decimal      @default(0.0) @db.Decimal(8, 2)
  roas              Decimal      @default(0.0) @db.Decimal(8, 2)
  hookRate          Decimal      @default(0.0) @db.Decimal(6, 2) // 3s / impressions * 100
  holdRate          Decimal      @default(0.0) @db.Decimal(6, 2) // 15s or ThruPlay / 3s * 100
  isFatigued        Boolean      @default(false)

  createdAt         DateTime     @default(now())

  @@index([date, platform])
}

model CreativeTag {
  id          String   @id @default(uuid())
  creativeId  String
  creative    Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  tagCategory String   // hook_type, offer, audience, visual_mood
  tagValue    String
  confidence  Decimal  @default(1.0) @db.Decimal(4, 2)
  createdAt   DateTime @default(now())
}

model OptimizationRule {
  id              String       @id @default(uuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  platform        PlatformType?
  conditionJson   Json         // e.g. { spend_threshold_x_cpa: 2.0, days: 3, conversions: 0 }
  actionType      ActionType
  actionPayload   Json?
  isEnabled       Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ActionItem {
  id              String       @id @default(uuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform        PlatformType
  entityType      String       // CAMPAIGN, ADSET, AD, KEYWORD
  entityId        String
  entityName      String
  actionType      ActionType
  status          ActionStatus @default(PENDING)
  proposedBy      String       // AGENT, RULE, USER
  reason          String
  previousValue   Json?
  newValue        Json?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  approvedAt      DateTime?
  executedAt      DateTime?
  undoneAt        DateTime?
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorType   String    // USER, AGENT, CRON
  actorId     String?
  action      String
  targetEntity String
  targetId    String?
  detailsJson Json?
  timestamp   DateTime  @default(now())
}

model Report {
  id              String       @id @default(uuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform        PlatformType?
  title           String
  dateRangeStart  DateTime     @db.Date
  dateRangeEnd    DateTime     @db.Date
  language        String       @default("BN") // BN or EN
  summaryMarkdown String       @db.Text
  metricsSnapshot Json
  insightsJson    Json?
  pdfUrl          String?
  excelUrl        String?
  createdAt       DateTime     @default(now())
}

model TrackingHealthCheck {
  id                  String              @id @default(uuid())
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId        String?
  connection          PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  platform            PlatformType
  channel             String              // BROWSER_PIXEL, SERVER_CAPI, GA4_GTAG, SERVER_GTM, TIKTOK_EVENTS
  eventName           String              // PageView, ViewContent, AddToCart, InitiateCheckout, Purchase
  status              HealthStatus        @default(GREEN)
  matchQualityScore   Decimal?            @db.Decimal(4, 1) // e.g. 8.6 out of 10
  deduplicationActive Boolean             @default(true)
  lastReceivedAt      DateTime?
  diagnosticsJson     Json?
  suggestedFixes      String?
  checkedAt           DateTime            @default(now())
}

model AgentConversation {
  id          String         @id @default(uuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    AgentMessage[]
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            // user, assistant, system, tool
  content        String            @db.Text
  toolCallsJson  Json?
  toolResultJson Json?
  contextJson    Json?             // current route, active platform, date range, account
  createdAt      DateTime          @default(now())
}
