{
  "$schema": "https://digiport.neexion.com/schemas/agent-capability.v1.json",
  "agent": "CampaignAgent",
  "platform": "TIKTOK",
  "supportedObjectives": ["CONVERSIONS", "TRAFFIC", "VIDEO_VIEWS", "LEAD_GENERATION"],
  "supportedCampaignTypes": ["REGULAR_AUCTION", "SPARK_ADS", "VIDEO_SHOPPING"],
  "supportedBiddingStrategies": ["LOWEST_COST", "BID_CAP", "COST_CAP"],
  "supportedAssetTypes": ["VERTICAL_VIDEO_9_16", "SPARK_AUTH_CODE", "DISPLAY_IMAGE"],
  "requiresApproval": true,
  "validationRules": [
    "Advertiser ID must be numeric string",
    "Video duration must be between 9 and 60 seconds",
    "TikTok Pixel / Events API must be verified"
  ]
}
